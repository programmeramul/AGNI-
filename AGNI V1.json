    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nconst text = response?.choices?.[0]?.message?.content \n  || response?.choices?.[0]?.text\n  || \"Sorry, I couldn't generate a response.\";\n\nconst clean = text\n  .trim()\n  .replace(/\\*\\*/g, '')\n  .replace(/\\*/g, '')\n  .replace(/\\_/g, '')\n  .replace(/\\`/g, '')\n  .replace(/\\#/g, '');\n\nreturn [{ json: { text: clean } }];"
      },
